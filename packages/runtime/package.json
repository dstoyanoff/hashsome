{
  "name": "@hashsome/runtime",
  "version": "0.12.0",
  "description": "Server + CLI that serves a project's own dashboards",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./app/index.ts",
    "./entry-client": "./app/entry.client.tsx",
    "./entry-server": "./app/entry.server.tsx",
    "./vite-config": "./src/vite-config.ts",
    "./serve": "./src/serve.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -b tsconfig.build.json"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "jsdom": "30.1.1"
  },
  "dependencies": {
    "@hashsome/core": "workspace:*",
    "@hashsome/ui": "workspace:*",
    "@react-router/dev": "8.4.0",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "vite": "8.3.1",
    "ws": "8.21.3"
  },
  "bin": {
    "hashsome": "./bin/hashsome.ts"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dstoyanoff/hashsome.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/dstoyanoff/hashsome#readme",
  "bugs": "https://github.com/dstoyanoff/hashsome/issues",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./app": {
        "types": "./dist/app/index.d.ts",
        "default": "./dist/app/index.js"
      },
      "./entry-client": {
        "types": "./dist/app/entry.client.d.ts",
        "default": "./dist/app/entry.client.js"
      },
      "./entry-server": {
        "types": "./dist/app/entry.server.d.ts",
        "default": "./dist/app/entry.server.js"
      },
      "./vite-config": {
        "types": "./dist/src/vite-config.d.ts",
        "default": "./dist/src/vite-config.js"
      },
      "./serve": {
        "types": "./dist/src/serve.d.ts",
        "default": "./dist/src/serve.js"
      }
    },
    "bin": {
      "hashsome": "./dist/bin/hashsome.js"
    }
  }
}
