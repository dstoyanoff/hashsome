{
  "name": "@hashsome/ui",
  "version": "0.12.0",
  "description": "Design system components and hooks",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./gallery": "./src/gallery/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "docs": "vite",
    "docs:build": "vite build",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@hashsome/core": "workspace:*",
    "e-prim": "2.0.1",
    "motion": "13.4.5",
    "react": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dstoyanoff/hashsome.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/dstoyanoff/hashsome#readme",
  "bugs": "https://github.com/dstoyanoff/hashsome/issues",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./gallery": {
        "types": "./dist/gallery/index.d.ts",
        "default": "./dist/gallery/index.js"
      }
    }
  }
}
