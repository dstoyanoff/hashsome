{
  "name": "@hashsome/integration.music-assistant",
  "version": "0.12.0",
  "description": "Music Assistant integration: direct WebSocket client, not via Home Assistant",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "players": "node scripts/print-players.ts",
    "build": "tsc -b tsconfig.build.json"
  },
  "dependencies": {
    "@hashsome/core": "workspace:*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./mock": "./src/mock.ts",
    "./package.json": "./package.json"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dstoyanoff/hashsome.git",
    "directory": "packages/integrations/music-assistant"
  },
  "homepage": "https://github.com/dstoyanoff/hashsome#readme",
  "bugs": "https://github.com/dstoyanoff/hashsome/issues",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./mock": {
        "types": "./dist/mock.d.ts",
        "default": "./dist/mock.js"
      },
      "./package.json": "./package.json"
    }
  }
}
