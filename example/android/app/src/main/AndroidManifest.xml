<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The example links `kiosk` only to open its settings sheet (DemoLaunch): it is not a kiosk, so nothing of kiosk's manifest stays. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" tools:node="remove" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:ignore="ProtectedPermissions" tools:node="remove" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" tools:node="remove" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="Hashsome example">

        <service android:name="dev.hashsome.kiosk.KioskService" tools:node="remove" />
        <receiver android:name="dev.hashsome.kiosk.BootReceiver" tools:node="remove" />
        <receiver android:name="dev.hashsome.kiosk.ProvisionReceiver" tools:node="remove" />
        <receiver android:name="dev.hashsome.kiosk.HashsomeDeviceAdmin" tools:node="remove" />
        <activity-alias android:name="dev.hashsome.kiosk.HomeActivityAlias" tools:node="remove" />

        <!-- The dashboard activity of dev.hashsome.ui, taking the runtime address from the intent. -->
        <activity
            android:name=".DemoActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
